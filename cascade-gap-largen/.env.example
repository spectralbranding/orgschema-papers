# .env.example
#
# Copy to .env and fill in actual values. NEVER commit .env.
# Per PUBLIC_MIRROR_STANDARD.md §7, .env is in .gitignore.

# LLM operator API keys (only required if pipeline calls LLMs)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=

# Zenodo upload (only required for release workflow)
ZENODO_TOKEN=

# Hugging Face Hub (only required for dataset publication)
HF_TOKEN=
